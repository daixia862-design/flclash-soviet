+class _BeamPainter extends CustomPainter {
+  const _BeamPainter({required this.color, required this.alpha});
+
+  final Color color;
+  final double alpha;
+
+  @override
+  void paint(Canvas canvas, Size size) {
+    if (size.isEmpty) {
+      return;
+    }
+    final paint = Paint()..color = color.withValues(alpha: alpha);
+    const band = 78.0;
+    const slant = 0.62;
+    final shift = size.height * slant;
+    for (var x = -shift; x < size.width + band; x += band * 2.4) {
+      final path = Path()
+        ..moveTo(x, 0)
+        ..lineTo(x + band, 0)
+        ..lineTo(x + band + shift, size.height)
+        ..lineTo(x + shift, size.height)
+        ..close();
+      canvas.drawPath(path, paint);
+    }
+  }
+
+  @override
+  bool shouldRepaint(_BeamPainter oldDelegate) =>
+      oldDelegate.color != color || oldDelegate.alpha != alpha;
+}
